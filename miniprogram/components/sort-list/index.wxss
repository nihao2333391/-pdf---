.sort-viewport { border-top: 1rpx solid #d9d2cc; border-bottom: 1rpx solid #d9d2cc; }
.sort-row { display: flex; align-items: center; border-bottom: 1rpx solid #d9d2cc; box-sizing: border-box; }
.sort-row:last-child { border-bottom: 0; }
.sort-row--active { background: #f5e6e5; box-shadow: inset 4rpx 0 #b85855; }
.handle { width: 84rpx; height: 100%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.handle-icon { width: 42rpx; height: 42rpx; }
.content { flex: 1; min-width: 0; padding: 16rpx 0; display: flex; align-items: center; }
.row-copy { flex: 1; min-width: 0; }
.material-icon { width: 42rpx; height: 50rpx; flex-shrink: 0; margin-right: 12rpx; }
.sort-viewport--compact { border: 1rpx solid #d9d2cc; border-radius: 8rpx; background: #fffdfa; }
.sort-viewport--compact .handle { width: 56rpx; min-width: 28px; }
.sort-viewport--compact .handle-icon { width: 32rpx; height: 36rpx; }
.sort-viewport--compact .detail { font-size: 22rpx; margin-top: 2rpx; }
.sort-viewport--compact .remove { width: 76rpx; min-width: 40px; }
.title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #172331; font-size: 34rpx; font-weight: 700; }
.detail { color: #64676b; font-size: 25rpx; margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.remove,.arrow { display: flex; align-items: center; justify-content: center; width: 88rpx; min-height: 88rpx; height: 100%; flex-shrink: 0; }
.end-icon { width: 36rpx; height: 36rpx; }

.sort-viewport--compact .title { font-size: 32rpx; font-weight: 400; }
